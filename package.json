{
  "name": "estoque-contas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create estoque_contas_db",
    "db:migrate:local": "wrangler d1 execute estoque_contas_db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute estoque_contas_db --remote --file=./schema.sql",
    "secret:set-groq": "wrangler secret put GROQ_API_KEY",
    "secret:set-session": "wrangler secret put SESSION_SECRET",
    "secret:set-crypto": "wrangler secret put CRYPTO_KEY",
    "secret:set-password": "wrangler secret put PANEL_PASSWORD_HASH"
  },
  "dependencies": {
    "hono": "^4.6.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
